@pure @const {
make std = @import "./library/std/pkg.quip"
}

@pub @entry
make main () {

    std::io::println("building Quip compiler")

    make b = std::Build.default()

    make exe = std::Executable.default()

    // test of package alias, not working yet
    // make pkg = std::Package.create("std", "./library/std/pkg.quip")
    // exe.add_package(pkg)

    make path = std::io::Path.create("bootstrap/")
    exe.path_build = path
    exe.name = "quipc"

    b.executables.push(exe)

    b.proceed() catch {
        std::io::println("unable to build the compiler")
    }

    return 0
}
