@pure @const {
make block: unit = @import "block.quip"
make syscall: unit = @import "../os/syscall.quip"

make std: unit = @import "../pkg.quip"

}

@pub
make type Heap {
    make head: ptr<block::Block>?
    make size: int = 1048576

    make alloc_count: int = 0
    make free_count: int = 0

    @pub
    make init () -> Heap {

        make h = Heap {
            head = none
        }

        @unsafe {
            // map anonymous memory
            make raw_mem: ptr<any> = syscall::quip_map_anon(1048576)
            make block_ptr: ptr<block::Block> = raw_mem

            block_ptr.*.free = true
            block_ptr.*.size = 1048576 - (@sizeof block::Block)
            block_ptr.*.next = none

            h.head = block_ptr
        }

        return h
    }

    @pub @this @allocator
    make alloc (req_size: int) -> !owned<any> {
        if req_size == 0 {
            return error.ZeroAllocation
        }

        @unsafe {

            make curr: ptr<block::Block>? = this.head

            while curr != none {

                make some = curr.unwrap()

                if some.*.free {
                    make has_space: bool = some.*.size > req_size + (@sizeof block::Block)
                    if has_space {
                        this.alloc_count = this.alloc_count + 1
                        some.*.split(req_size + 0)
                        some.*.free = false
                        @unsafe make ptr_res_space: ptr<block::Block> = some + 1
                        @unsafe return ptr_res_space
                    }

                    make fits: bool = some.*.size >= req_size
                    if fits {
                        this.alloc_count = this.alloc_count + 1
                        some.*.free = false
                        @unsafe make ptr_res_exact: ptr<block::Block> = some + 1
                        @unsafe return ptr_res_exact
                    }
                }
                curr = some.*.next
            }
        }

        return error.OutOfMemory
    }

    @pub @this @deallocator
    make free (raw_ptr: owned<any>) -> void {
        @unsafe {
            this.free_count = this.free_count + 1
            make block_ptr: ptr<block::Block> = raw_ptr
            make header: ptr<block::Block> = block_ptr - 1
            header.*.free = true
            header.*.join()
        }
    }

    @pub @this
    make dump () {
        std::io::println("Debug allocations: ".to_str() + this.alloc_count.to_str())
        std::io::println("Debug frees: ".to_str() + this.free_count.to_str())
        std::io::println("Debug leaks: ".to_str() + (this.alloc_count - this.free_count).to_str())
    }
}
