@pure @const {

make heap: unit = @import "../mem/pkg.quip"

}

@pub @pure @const {

make syscall: unit = @import "syscall.quip"

}


@pub
make getcwd() -> str {

    @unsafe {

        make result: str = ""

        if syscall::quip_getcwd(result.pin) < 0 {
            return result
        }

        return result

    }
}

@pub
make getenv(name: str) -> str {

    @unsafe {

        make result: str = ""

        if syscall::quip_getenv(name.data, result.pin) < 0 {
            return result
        }

        return result

    }
}
