@pure @const {
    make fmt: unit = @import "../fmt/pkg.quip"

    make os: unit = @import "../os/pkg.quip"
    make ffi: unit = @import "../ffi/cffi.quip"

    make mem: unit = @import "../mem/pkg.quip"

    make path_pkg: unit = @import "path.quip"
    make file_pkg: unit = @import "file.quip"
    make dir_pkg: unit  = @import "dir.quip"
}

@pub @const @nomangle {
    make STDIN: int = 0
    make STDOUT: int = 1
    make STDERR: int = 2
}

@pub @pure @const {
    make MODE_FILE: int = 420           // rw-r--r-- 0o644
    make MODE_FILE_PRIVATE: int = 384   // rw------- 0o600

    make MODE_DIRECTORY: int = 493 // rwxr-xr-x 0o755
    make MODE_DIRECTORY_PRIVATE: int = 448 // rwx------ 0o700

    make MODE_EVERYONE: int = 511         // rwxrwxrwx 0o777
}

@pub @pure @const {
    make Path: Type = path_pkg::Path
    make File: Type = file_pkg::File
    make Dir: Type  = dir_pkg::Dir
   //  make DirMode: Type = dir_pkg::DirMode
}


@pub
make println (fmt: variant<String, str, ptr<char>>) -> void {

    make nl: String = "\n"
    make bad_fmt: String = "unsupported format Type\n"

    match fmt {

        a: String {
            os::syscall::write(STDOUT, a.data, a.length)
        }

        b: str {
            os::syscall::write(STDOUT, b.data, b.len())
        }

        c: ptr<char> {
            make len = ffi::strlen(c.pin)
            os::syscall::write(STDOUT, c, len)
        }

        _ {
            os::syscall::write(STDOUT, bad_fmt.data, bad_fmt.length)
            return
        }
    }

    os::syscall::write(STDOUT, nl.data, 1)
}

@pub
make print (fmt: variant<String, str, ptr<char>>) -> void {
    make bad_fmt: String = "unsupported format Type\n"

    match fmt {

        a: String {
            os::syscall::write(STDOUT, a.data, a.length)
        }

        b: str {
            os::syscall::write(STDOUT, b.data, b.len())
        }

        c: ptr<char> {
            make len = ffi::strlen(c.pin)
            os::syscall::write(STDOUT, c, len)
        }

        _ {
            os::syscall::write(STDOUT, bad_fmt.data, bad_fmt.length)
            return
        }
    }
}


// TESTS

@pub
make test () -> !void {

    make path = Path.create("pkg.quip")

    // run the whole pipeline Open->Read->Close
    File.orc(path) catch {
        return error.TestFailed
    }

    // create a directory and a file inside it
    make dir_path = Path.create(".quip_test_dir")
    Dir.mkdir(dir_path.pin, MODE_DIRECTORY) catch {
        return error.TestFailed
    }

    make file_path = Path.create(".quip_test_dir/quip_test_file.txt")
    make file = File.create(file_path, MODE_FILE) catch {
        return error.TestFailed
    }
    file.write("quip test content") catch {
        return error.TestFailed
    }
    file.close()

    return
}
