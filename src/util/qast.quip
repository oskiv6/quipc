@pub
make type QAST_If {
    make head: QAST_Head

    make val: owned<QAST_Head>
    make statements: QAST_Statements
    make elif_block: owned<QAST_Head> // QAST_If
    make else_block: QAST_Statements

    @pub @this
    make copy () -> QAST_If {
        make c = QAST_If {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.val = this.val.copy()
        c.statements = this.statements.copy()

        return c
    }
}

@pub
make type QAST_For {
    make head: QAST_Head

    make inc: lexer::Token
    make cond: owned<QAST_Head> // expr

    make statements: QAST_Statements

    @pub @this
    make copy () -> QAST_For {
        make c = QAST_For {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.inc = this.inc
        c.cond = this.cond.copy()
        c.statements = this.statements.copy()

        return c
    }
}

@pub
make type QAST_While {
    make head: QAST_Head

    make cond: owned<QAST_Head> // expr

    make statements: QAST_Statements

    @pub @this
    make copy () -> QAST_While {
        make c = QAST_While {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.cond = this.cond.copy()
        c.statements = this.statements.copy()

        return c
    }
}

@pub
make type QAST_Arg {

    make name: lexer::Token
    make val: owned<QAST_Head> // expr

    @pub @this
    make copy () -> QAST_Arg {
        make c = QAST_Arg {}

        c.name = this.name

        make oc = std::mem::debug.alloc(@sizeof QAST_Expr).unwrap()
        oc.* = this.val.*.copy()
        c.val = oc

        return c
    }
}

@pub
make type QAST_Param {

    make name: lexer::Token
    make res_type: qtype::QType
    make sig_type: owned<QAST_TypeSig>?
    make def_val: owned<QAST_Head>

    @pub @this
    make copy () -> QAST_Param {
        make c = QAST_Param {}

        c.name = this.name
        c.res_type = this.res_type

        match this.sig_type {
            none { c.sig_type = none }
            some {

                make oc: owned<QAST_TypeSig> = std::mem::debug.alloc(@sizeof QAST_TypeSig).unwrap()
                oc.* = some.*.copy()
                c.sig_type = oc

            }
        }

        c.def_val = this.def_val.copy()

        return c
    }
}


@pub
make type QAST_Var {
    make head: QAST_Head

    make name: lexer::Token
    make sig_type: owned<QAST_TypeSig>?
    make res_type: qtype::QType

    make val: owned<QAST_Head>?

    @pub @this
    make copy () -> QAST_Var {
        make c = QAST_Var {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.name = this.name

        match this.sig_type {
            none { c.sig_type = none }
            some {
                make oc: owned<QAST_TypeSig> = std::mem::debug.alloc(@sizeof QAST_TypeSig).unwrap()
                oc.* = some.*.copy()
                c.sig_type = oc
            }
        }

        c.res_type = this.res_type

        match this.val {
            none { c.val = none }
            some { c.val = some.copy() }
        }

        return c
    }
}

@pub
make type QAST_Statements {

    make buffer: owned<QAST_Head>[]
    make local_table: symbol::SymbolTable

    @pub @this
    make copy () -> QAST_Statements {
        make c = QAST_Statements {}

        for stmt : this.buffer {
            c.buffer = c.buffer + [stmt.copy()]
        }

        c.local_table = this.local_table

        return c
    }
}

@pub
make type QAST_Expr {
    make head: QAST_Head
    make kind: ExprKind
    make res_type: qtype::QType

    make binary: ExprBinary
    make constructor: ExprConstructor
    make access: ExprAccess
    make unary: ExprUnary
    make call: ExprCall

    make literal: lexer::Token

    make is_copy: bool

    @pub @this
    make copy () -> QAST_Expr {
        make c = QAST_Expr {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.kind = this.kind
        c.res_type = this.res_type

        c.binary = this.binary.copy()
        c.constructor = this.constructor.copy()
        c.access = this.access.copy()
        c.unary = this.unary.copy()
        c.call = this.call.copy()

        c.literal = this.literal
        c.is_copy = this.is_copy

        return c
    }
}

// Expression helpers

@pub
make type ExprBinary {
    make left: owned<QAST_Head>
    make op: lexer::Token
    make right: owned<QAST_Head>

    @pub @this
    make copy () -> ExprBinary {
        make c = ExprBinary {}

        c.left = this.left.copy()
        c.op = this.op
        c.right = this.right.copy()

        return c
    }
}

@pub
make type ExprConstructor {
    make fields: owned<QAST_Head>[]

    @pub @this
    make copy () -> ExprConstructor {
        make c = ExprConstructor {}

        for field : this.fields {
            c.fields = c.fields + [field.copy()]
        }

        return c
    }
}

@pub
make type ExprAccess {
    make left: owned<QAST_Head>
    make right: owned<QAST_Head>

    make is_array: bool

    @pub @this
    make copy () -> ExprAccess {
        make c = ExprAccess {}

        c.left = this.left.copy()
        c.right = this.right.copy()
        c.is_array = this.is_array

        return c
    }
}

@pub
make type ExprCall {
    make callee: owned<QAST_Head>
    make args: QAST_Arg[]

    make catch_stmts: QAST_Statements?
    make catch_bind: variant<void, lexer::Token>

    @pub @this
    make copy () -> ExprCall {
        make c = ExprCall {}

        c.callee = this.callee.copy()

        for arg : this.args {
            c.args = c.args + [arg.copy()]
        }

        match this.catch_stmts {
            none { c.catch_stmts = none }
            some { c.catch_stmts = some.copy() }
        }

        c.catch_bind = this.catch_bind

        return c
    }
}

@pub
make type QAST_Assign {
    make head: QAST_Head
    make target: owned<QAST_Head>
    make value: owned<QAST_Head>

    @pub @this
    make copy () -> QAST_Assign {
        make c = QAST_Assign {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.target = this.target.copy()
        c.value = this.value.copy()

        return c
    }
}

@pub
make type QAST_Return {
    make head: QAST_Head
    make value: owned<QAST_Head>

    @pub @this
    make copy () -> QAST_Return {
        make c = QAST_Return {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.value = this.value.copy()

        return c
    }
}

@pub
make type ExprUnary {
    make op: lexer::Token
    make operand: owned<QAST_Head>

    @pub @this
    make copy () -> ExprUnary {
        make c = ExprUnary {}

        c.op = this.op
        c.operand = this.operand.copy()

        return c
    }
}
