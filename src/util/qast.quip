@pure @const {
make util = @import "./pkg.quip"
make lexer = @import "../core/token.quip"

make qtype = @import "../semantics/qtype.quip"
make symbol = @import "../semantics/symbol.quip"

make std = @import "../../library/std/pkg.quip"
}

// ====

@pub
make enum QAST_Status {
    Ok,
    Error,
}

@pub
make enum QAST_Kind {
    Tag,
    Func,
    Var,
    Expr,
    Type,
    Enum,
    If,
    For,
    While,
    Match,
    Catch,
    Assign,
    Return,
}

@pub
make type FuncCtx {
    make is_returning: bool
    make is_return_locked: bool
    make res_type: qtype::QType
}

@pub
make enum Visibility {
    Public,
    Private,
}

@pub
make type QAST_Head {
    make range: util::Range
    make kind: QAST_Kind
    make status: QAST_Status
    make tags: owned<QAST_Head>[]

    @pub @this
    make copy () -> owned<QAST_Head> {
        match this.kind {

            QAST_Kind.Tag {
                @unsafe make node: ptr<QAST_Tag> = this

                make new: owned<QAST_Tag> = std::mem::debug.alloc(@sizeof QAST_Tag).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Func {
                @unsafe make node: ptr<QAST_Func> = this

                make new: owned<QAST_Func> = std::mem::debug.alloc(@sizeof QAST_Func).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Var {
                @unsafe make node: ptr<QAST_Var> = this

                make new: owned<QAST_Var> = std::mem::debug.alloc(@sizeof QAST_Var).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Expr {
                @unsafe make node: ptr<QAST_Expr> = this

                make new: owned<QAST_Expr> = std::mem::debug.alloc(@sizeof QAST_Expr).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Type {
                @unsafe make node: ptr<QAST_Type> = this

                make new: owned<QAST_Type> = std::mem::debug.alloc(@sizeof QAST_Type).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Enum {
                @unsafe make node: ptr<QAST_Enum> = this

                make new: owned<QAST_Enum> = std::mem::debug.alloc(@sizeof QAST_Enum).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.If {
                @unsafe make node: ptr<QAST_If> = this

                make new: owned<QAST_If> = std::mem::debug.alloc(@sizeof QAST_If).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.For {
                @unsafe make node: ptr<QAST_For> = this

                make new: owned<QAST_For> = std::mem::debug.alloc(@sizeof QAST_For).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.While {
                @unsafe make node: ptr<QAST_While> = this

                make new: owned<QAST_While> = std::mem::debug.alloc(@sizeof QAST_While).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Assign {
                @unsafe make node: ptr<QAST_Assign> = this

                make new: owned<QAST_Assign> = std::mem::debug.alloc(@sizeof QAST_Assign).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            QAST_Kind.Return {
                @unsafe make node: ptr<QAST_Return> = this

                make new: owned<QAST_Return> = std::mem::debug.alloc(@sizeof QAST_Return).unwrap()

                new.* = node.*.copy()

                @unsafe return new
            }

            _ {
                std::io::println("unable to copy")
                @unsafe return this
            }
        }
    }
}

@pub
make enum ExprKind {
    Unknown,
    Literal,
    Identifier,
    Binary,
    Unary,
    Call,
    Access,
    Constructor,
    // Lambda
}

// QAST nodes

@pub
make type QAST_Tag {
    make head: QAST_Head
    make name: lexer::Token

    make val: owned<QAST_Head>?
    make sig_type: owned<QAST_TypeSig>?

    @pub @this
    make copy () -> QAST_Tag {
        make c = QAST_Tag {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = [] // tag cannot hold another tag

        c.name = this.name

        match this.val {
            none { c.val = none }
            some { c.val = some.copy() }
        }

        match this.sig_type {
            none { c.sig_type = none }
            some {
                make oc: owned<QAST_TypeSig> = std::mem::debug.alloc(@sizeof QAST_TypeSig).unwrap()
                oc.* = some.*.copy()

                c.sig_type = oc
            }
        }

        return c
    }
}

@pub
make type QAST_TypeSig {
    make range: util::Range

    make name: lexer::Token
    make inner: owned<QAST_TypeSig>[]

    make array_size: owned<QAST_Head> // expr

    make is_fallible: bool
    make is_optional: bool
    make is_generic: bool
    make is_array: bool

    @pub @this
    make copy () -> QAST_TypeSig {
        make c = QAST_TypeSig {}

        c.range = this.range
        c.name = this.name

        for item : this.inner {

            make oc: owned<QAST_TypeSig> = std::mem::debug.alloc(@sizeof QAST_TypeSig).unwrap()
            oc.* = item.*.copy()

            c.inner.push(oc)
        }

        c.array_size = this.array_size.copy()

        c.is_fallible = this.is_fallible
        c.is_optional = this.is_optional
        c.is_generic = this.is_generic
        c.is_array = this.is_array

        return c
    }
}

@pub
make type QAST_Func {
    make head: QAST_Head

    make name: lexer::Token

    make res_type: qtype::QType
    make sig_type: owned<QAST_TypeSig>?
    make generics: lexer::Token[]

    make statements: QAST_Statements

    make params: QAST_Param[]

    // size of bytes allocated on stack
    make local_size: uint

    make mangled_name: str

    make visibility: Visibility

    make fctx: FuncCtx

    @pub @this
    make copy () -> QAST_Func {
        make c = QAST_Func {}

        c.head.range = this.head.range
        c.head.kind = this.head.kind
        c.head.status = this.head.status
        c.head.tags = []

        for tag : this.head.tags {
            c.head.tags = c.head.tags + [tag.copy()]
        }

        c.name = this.name
        c.res_type = this.res_type

        match this.sig_type {
            none { c.sig_type = none }
            some {
                make oc: owned<QAST_TypeSig> = std::mem::debug.alloc(@sizeof QAST_TypeSig).unwrap()
                oc.* = some.*.copy()
                c.sig_type = oc
            }
        }

        c.generics = this.generics

        c.statements = this.statements.copy()

        for param : this.params {
            c.params = c.params + [param.copy()]
        }

        c.local_size = this.local_size
        c.mangled_name = this.mangled_name
        c.visibility = this.visibility
        c.fctx = this.fctx

        return c
    }
}

@pub
make type QAST_Type {
    make head: QAST_Head

    make name: lexer::Token
    make generics: lexer::Token[]

    make statements: QAST_Statements

    @pub @this
