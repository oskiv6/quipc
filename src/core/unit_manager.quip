// Unit is responsible for representing single file
// it contains pipeline, which shows the current state of the compilation process
// tokens,
// AST -> QAST
// other internal data

// The UnitManager is responsible for managing already imported files and mark the main file

@pure @const {
make std = @import "../../library/std/pkg.quip"

make lexer = @import "token.quip"
make parser = @import "parser.quip"
make qast = @import "../util/qast.quip"

make diags = @import "../diag/diagnosis.quip"

make linemap = @import "../core/sourcemap.quip"

// the flattening is not working now, may giev compile errors
make flattening = @import "../semantics/flattening.quip"
}

@pub
make enum UnitStatus {
    Unloaded,
    Lexing,
    Parsing,
    PreAnalysis,
    Analysis,
    MemAnalysis,
    LLVM,
    Done
}

@pub
make type Unit {
    make content: str
    make map: linemap::LineMap
    make tokens: lexer::Token[]

    make path_abs: std::io::Path
    make program: owned<qast::QAST_Head>[]

    make status: UnitStatus

    make lsp_mode: bool
    make diag: diags::Diagnostic

    @pub
    make init (path: std::io::Path) -> !Unit {

        make u = Unit {}
        u.diag = diags::Diagnostic.init()
        u.lsp_mode = false

        // u.path_abs = path.absolute()

        make f = std::io::File.open(path) catch {
            std::io::println("File not found")
            return error.UnableToInitUnit
        }

        f.read() catch {
            return error.UnableToInitUnit
        }

        u.content = f.content

        u.map = linemap::LineMap.init(u.content.pin)

        f.close()
        u.status = UnitStatus.Unloaded

        return u
    }

    @pub @this
    make set_lsp_mode () {
        this.lsp_mode = true
    }

    @pub @this
    make proceed () -> !void {
        this.status = UnitStatus.Lexing
        this.tokens = lexer::tokenize(this.content) catch err {
            return err
        }

        make p = parser::Parser.init(this.tokens.pin)
        this.program = p.proceed(this)
        if this.diag.has_errors() {
            std::process::abort()
        }

        // not working
        // flattening::run(this.program)

        parser::debug_display(this.program)

        return
    }
}

@pub
make type UnitManager {

    make units: Unit[]

    @pub
    make init (main: std::io::Path) -> !UnitManager {

        make unit: Unit = Unit.init(main) catch {
            return error.MissingMainUnit
        }

        make manager = UnitManager {}
        manager.units.push(unit)

        return manager
    }

    @pub @this
    make open (path: std::io::Path) -> void {
        return
    }

    @pub @this
    make proceed_all () -> !void {
        for unit : this.units.iter() {
            unit.proceed() catch err {
                return err
            }
        }
    }

}
