@pure @const {
make std = @import "../../library/std/pkg.quip"

make lexer = @import "token.quip"
make qast = @import "../util/qast.quip"
make symbol = @import "../semantics/symbol.quip"

make diag = @import "../diag/diagnosis.quip"
make err = @import "../diag/err.quip"

make um = @import "unit_manager.quip"

make util = @import "../util/pkg.quip"
}

@pub
make type Parser {
    make tokens: ref<lexer::Token[]>
    make index: int

    make lock_statements: bool

    @pub
    make init (tokens: ref<lexer::Token[]>) -> Parser {
        make parser = Parser {}
        parser.tokens = tokens
        parser.index = 0
        parser.lock_statements = false

        return parser
    }

    @this
    make current () -> ref<lexer::Token> { return this.tokens.*[this.index].pin }

    @this
    make next () -> ref<lexer::Token> { return this.tokens.*[this.index + 1].pin }

    @this
    make prev () -> ref<lexer::Token> { return this.tokens.*[this.index - 1].pin }

    @this
    make advance () -> void { this.index = this.index + 1 }

    @this
    make expect (kind: lexer::TokenKind) -> !ref<lexer::Token> {
        if this.current().*.kind == kind {
            make t = this.current()
            this.advance()
            return t
        }

        this.advance()

        return error.UnexpectedToken
    }

    @pub @this
    make proceed (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head>[] {
        make program: owned<qast::QAST_Head>[] = []

        while this.current().*.kind != lexer::TokenKind.EOF {
            match this.current().*.kind {

                lexer::TokenKind.At {
                    program.push(this.parse_tag(ctx))
                }

                lexer::TokenKind.KeyMake {
                    program.push(this.parse_make(ctx))
                }
            }


            if this.current().*.kind == lexer::TokenKind.EOF {
                break
            }
        }

        return program
    }

    @this
    make parse_tag (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        this.advance()

        make node: owned<qast::QAST_Tag> = std::mem::debug.alloc(@sizeof qast::QAST_Tag).unwrap()
        node.*.head.kind = qast::QAST_Kind.Tag
        node.*.head.range.unit = ctx
        node.*.head.range.start = this.current().*.span

        node.*.name = this.expect(lexer::TokenKind.Identifier) catch {
            node.*.head.status = qast::QAST_Status.Error
            node.*.head.range.end = this.current().*.span

            make d = diag::Diag.err(err::Err.UnexpectedToken, node.*.head.range, "unexpected token")
            ctx.*.diag.report(d)

            this.recover(ctx)
            @unsafe return node
        }.*

        node.*.val = none
        if this.current().*.kind == lexer::TokenKind.LiteralString {
            node.*.val = this.parse_expr(ctx)
        }

        node.*.head.range.end = this.prev().*.span

        @unsafe return node
    }

    @this
    make parse_make (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        this.advance()

        make node: owned<qast::QAST_Head> = std::mem::debug.alloc(@sizeof qast::QAST_Head).unwrap()
        node.*.status = qast::QAST_Status.Error

        match this.current().*.kind {
            lexer::TokenKind.Identifier {

                if this.next().*.kind == lexer::TokenKind.LParen || this.next().*.kind == lexer::TokenKind.Less {
                    std::mem::debug.free(node)
                    node = this.parse_func(ctx)
                    return node

                } else {
                    std::mem::debug.free(node)
                    node = this.parse_var(ctx)
                    return node
                }
            }

            lexer::TokenKind.KeyType {
                this.advance()
                std::mem::debug.free(node)
                node = this.parse_type(ctx)
                return node
            }

            lexer::TokenKind.KeyEnum {
                this.advance()
                std::mem::debug.free(node)
                node = this.parse_enum(ctx)
                return node
            }

            _ {

                make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexepcted token")
                d.help("try to declare a variable, Type, enum or function")
                ctx.*.diag.report(d)

                this.recover(ctx)
            }
        }

        return node
    }

    @this
    make parse_func (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make node: owned<qast::QAST_Func> = std::mem::debug.alloc(@sizeof qast::QAST_Func).unwrap()
        node.*.head.kind = qast::QAST_Kind.Func
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.name = this.expect(lexer::TokenKind.Identifier) catch {}.*

        node.*.generics = []
        if this.current().*.kind == lexer::TokenKind.Less {
            this.advance() // skip '<'

            while this.current().*.kind != lexer::TokenKind.Greater {
                make g = this.expect(lexer::TokenKind.Identifier) catch {}.*
                node.*.generics.push(g)

                if this.current().*.kind == lexer::TokenKind.Comma {
                    this.advance()
                }
            }

            this.advance() // skip '>'
        }

        node.*.params = this.parse_param(ctx)

        if this.current().*.kind == lexer::TokenKind.Arrow {
            this.advance()
            node.*.sig_type = this.parse_type_signature(ctx)
        }

        match this.parse_statements(ctx) {
            none {
                node.*.head.status = qast::QAST_Status.Error
            }

            some: qast::QAST_Statements {
                node.*.statements = some
            }
        }

        @unsafe return node
    }

    @this
    make parse_var (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make node: owned<qast::QAST_Var> = std::mem::debug.alloc(@sizeof qast::QAST_Var).unwrap()
        node.*.head.kind = qast::QAST_Kind.Var
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.name = this.expect(lexer::TokenKind.Identifier) catch { // handle identifier
            node.*.head.status = qast::QAST_Status.Error

            make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexepcted token")
            ctx.*.diag.report(d)

            this.recover(ctx)

            @unsafe return node
        }.*

        // developer may specify a type after the identifier or just the expression
        // but they cannot specify none of them

        make satisfied = false

        node.*.val = none
        if this.current().*.kind == lexer::TokenKind.Colon {
            this.advance()
            satisfied = true

            node.*.sig_type = this.parse_type_signature(ctx)


            if this.current().*.kind == lexer::TokenKind.Equal {
                this.advance()
                node.*.val = this.parse_expr(ctx)
            }

        } elif this.current().*.kind == lexer::TokenKind.Equal {
            this.advance()
            satisfied = true
            node.*.val = this.parse_expr(ctx)
        }

        if !satisfied {
            node.*.head.status = qast::QAST_Status.Error

            make d = diag::Diag.err(err::Err.InvalidSyntax, util::Range {}, "invalid syntax")
            d.help("variable declaration must specified at least one of the following: Type signature, value or both")
            ctx.*.diag.report(d)

            this.recover(ctx)

            @unsafe return node
        }

        @unsafe return node
    }

    @this
    make parse_type (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make node: owned<qast::QAST_Type> = std::mem::debug.alloc(@sizeof qast::QAST_Type).unwrap()
        node.*.head.kind = qast::QAST_Kind.Type
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.name = this.expect(lexer::TokenKind.Identifier) catch {}.*

        if this.current().*.kind == lexer::TokenKind.Less { // start generic identifiers parsing
            this.advance()

            while this.current().*.kind != lexer::TokenKind.Greater {

                make generic = this.expect(lexer::TokenKind.Identifier) catch {}.*

                if this.current().*.kind == lexer::TokenKind.Comma {
                    this.advance()
                }

                node.*.generics.push(generic)
            }

            this.advance() // skip '>'
        }

        this.lock_statements = false
        match this.parse_statements(ctx) {
            none {
                node.*.head.status = qast::QAST_Status.Error
            }

            some: qast::QAST_Statements {
                node.*.statements = some
            }
        }

        @unsafe return node
    }

    @this
    make parse_enum (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make node: owned<qast::QAST_Enum> = std::mem::debug.alloc(@sizeof qast::QAST_Enum).unwrap()
        node.*.head.kind = qast::QAST_Kind.Enum
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.name = this.expect(lexer::TokenKind.Identifier) catch {}.*

        this.expect(lexer::TokenKind.LBrace) catch {}

        while this.current().*.kind != lexer::TokenKind.RBrace {
            make variant = this.expect(lexer::TokenKind.Identifier) catch {}.*

            if this.current().*.kind == lexer::TokenKind.Comma { this.advance() }

            node.*.variants.push(variant)
        }
        this.advance()

        @unsafe return node
    }

    @this
    make parse_if (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        this.advance()

        make node: owned<qast::QAST_If> = std::mem::debug.alloc(@sizeof qast::QAST_If).unwrap()
        node.*.head.kind = qast::QAST_Kind.If
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.val = this.parse_expr(ctx)

        match this.parse_statements(ctx) {
            none {
                node.*.head.status = qast::QAST_Status.Error
            }

            some: qast::QAST_Statements {
                node.*.statements = some
            }
        }

        @unsafe return node
    }

    @this
    make parse_for (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        this.advance()

        make node: owned<qast::QAST_For> = std::mem::debug.alloc(@sizeof qast::QAST_For).unwrap()
        node.*.head.kind = qast::QAST_Kind.For
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.inc = this.expect(lexer::TokenKind.Identifier) catch {}.*

        this.expect(lexer::TokenKind.Colon) catch {}

        node.*.cond = this.parse_expr(ctx)

        match this.parse_statements(ctx) {
            none {
                node.*.head.status = qast::QAST_Status.Error
            }

            some: qast::QAST_Statements {
                node.*.statements = some
            }
        }

        @unsafe return node
    }

    @this
    make parse_while (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        this.advance()

        make node: owned<qast::QAST_While> = std::mem::debug.alloc(@sizeof qast::QAST_While).unwrap()
        node.*.head.kind = qast::QAST_Kind.While
        node.*.head.status = qast::QAST_Status.Ok
        node.*.head.range.start = this.current().*.span
        node.*.head.range.unit = ctx

        node.*.cond = this.parse_expr(ctx)
        match this.parse_statements(ctx) {
            none {
                node.*.head.status = qast::QAST_Status.Error
            }

            some: qast::QAST_Statements {
                node.*.statements = some
            }
        }

        @unsafe return node
    }


    @this
    make parse_type_signature (ctx: ptr<um::Unit>) -> owned<qast::QAST_TypeSig>? {
        make sig: owned<qast::QAST_TypeSig> = std::mem::debug.alloc(@sizeof qast::QAST_TypeSig).unwrap()
        sig.*.range.start = this.current().*.span

        if this.current().*.kind == lexer::TokenKind.Not {
            sig.*.is_fallible = true
            this.advance()
        }

        sig.*.name = this.expect(lexer::TokenKind.Identifier) catch {
            make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
            ctx.*.diag.report(d)

            this.recover(ctx)
            return none
        }.*

        // check for generics
        if this.current().*.kind == lexer::TokenKind.Less {
            sig.*.is_generic = true
            this.advance()

            while this.current().*.kind != lexer::TokenKind.Greater {

                sig.*.inner = match this.parse_type_signature(ctx) {
                    none => []
                    some: owned<qast::QAST_TypeSig> {
                        make inner: owned<qast::QAST_TypeSig>[] = sig.*.inner + [some]
                    } => inner
                }

                if this.current().*.kind == lexer::TokenKind.Comma {
                    this.advance()
                }
            }
        }

        // check for array
        if this.current().*.kind == lexer::TokenKind.LBracket {
            sig.*.is_array = true
            this.advance()
            sig.*.array_size = this.parse_expr(ctx)

            this.expect(lexer::TokenKind.RBracket) catch {
                make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
                ctx.*.diag.report(d)

                this.recover(ctx)

                return none
            }
        }

        // check for optional
        if this.current().*.kind == lexer::TokenKind.Question {
            sig.*.is_optional = true
            this.advance()
        }

        sig.*.range.end = this.current().*.span

        return sig
    }

    @this
    make parse_args (ctx: ptr<um::Unit>) -> qast::QAST_Arg[] {
        this.advance() // skip '('

        make args: qast::QAST_Arg[] = []

        while this.current().*.kind != lexer::TokenKind.RParen {

            if this.current().*.kind == lexer::TokenKind.Identifier && this.next().*.kind == lexer::TokenKind.Equal {
                // named argument
                make arg = qast::QAST_Arg {}
                arg.name = this.expect(lexer::TokenKind.Identifier).unwrap().*
                this.advance() // skip '='
                arg.val = this.parse_expr(ctx)

                args.push(arg)
            } else {

                make arg = qast::QAST_Arg {}
                arg.val = this.parse_expr(ctx)
                args.push(arg)
            }

            if this.current().*.kind == lexer::TokenKind.Comma {
                this.advance()
            } elif this.current().*.kind == lexer::TokenKind.RParen {
                break
            } else {
                make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
                ctx.*.diag.report(d)

                this.recover(ctx)

                return args
            }
        }

        this.expect(lexer::TokenKind.RParen) catch {}

        return args
    }

    @this
    make parse_param (ctx: ptr<um::Unit>) -> qast::QAST_Param[] {
        this.advance() // skip '('

        make params: qast::QAST_Param[] = []

        while this.current().*.kind != lexer::TokenKind.RParen {

            std::io::println(this.current().*.lexeme)

            make param: qast::QAST_Param = qast::QAST_Param {}
            param.name = this.expect(lexer::TokenKind.Identifier) catch {}.*
            this.expect(lexer::TokenKind.Colon) catch {}

            para*.sig_type = this.parse_type_signature(ctx)

            if this.current().*.kind == lexer::TokenKind.Equal {
                this.advance()

                param.def_val = this.parse_expr(ctx)
            }

            if this.current().*.kind == lexer::TokenKind.Comma {
                this.advance()
            }

            params.push(param)
        }

        this.expect(lexer::TokenKind.RParen) catch {}

        return params
    }

    @this
    make parse_statement (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head>? {

        match this.current().*.kind {
            lexer::TokenKind.KeyMake {
                return this.parse_make(ctx)
            }

            lexer::TokenKind.KeyIf {
                if this.lock_statements {
                    make d = diag::Diag.err(err::Err.InvalidSyntax, util::Range {}, "unexpected statement")
                    ctx.*.diag.report(d)
                    this.recover(ctx)
                    return none
                }
                return this.parse_if(ctx)
            }

            lexer::TokenKind.KeyFor {
                if this.lock_statements {
                    make d = diag::Diag.err(err::Err.InvalidSyntax, util::Range {}, "unexpected statement")
                    ctx.*.diag.report(d)
                    this.recover(ctx)
                    return none
                }
                return this.parse_for(ctx)
            }

            lexer::TokenKind.KeyWhile {
                if this.lock_statements {
                    make d = diag::Diag.err(err::Err.InvalidSyntax, util::Range {}, "unexpected statement")
                    ctx.*.diag.report(d)
                    this.recover(ctx)
                    return none
                }
                return this.parse_while(ctx)
            }

            _ {
                return this.parse_expr(ctx)
            }
        }
    }

    @this
    make parse_statements (ctx: ptr<um::Unit>) -> qast::QAST_Statements? {
        make stmts = qast::QAST_Statements {
            buffer = [],
            local_table = symbol::SymbolTable {}
        }

        this.expect(lexer::TokenKind.LBrace) catch {
            make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
            ctx.*.diag.report(d)

            this.recover(ctx)

            return none
        }

        while this.current().*.kind != lexer::TokenKind.RBrace && this.current().*.kind != lexer::TokenKind.EOF {
            match this.parse_statement(ctx) {
                none {}

                some: owned<qast::QAST_Head> {
                    stmts.buffer.push(some)
                }
            }
        }

        this.expect(lexer::TokenKind.RBrace) catch {
            make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
            ctx.*.diag.report(d)

            this.recover(ctx)

            return none
        }

        return stmts
    }

    @this
    make parse_expr (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {

        make tags: owned<qast::QAST_Head>[] = []

        while this.current().*.kind == lexer::TokenKind.At {
            tags.push(this.parse_tag(ctx))
        }

        make node: owned<qast::QAST_Head> = this.parse_assignment(ctx)
        node.*.tags = tags

        @unsafe {
            make expr: owned<qast::QAST_Expr> = node
            if this.current().*.kind == lexer::TokenKind.Not {
                expr.*.is_copy = true
            } else {
                expr.*.is_copy = false
            }

            node = expr
        }

        @unsafe return node
    }

    @this
    make parse_assignment (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_logic_or(ctx)

        if this.current().*.is_assign_op() {
            make op: lexer::Token = this.current().*
            this.advance()

            make right = this.parse_assignment(ctx)

            // make left_node: owned<qast::QAST_Expr>
            @unsafe {
                if left.*.kind != qast::QAST_Kind.Expr {
                //     left_node = left
                // } else {
                    make d = diag::Diag.panic(err::Err.BadNodeKind, "compiler encountered an unexpected node kind")
                    if ctx.*.diag.report(d) && ctx.*.lsp_mode == false { std::process::abort() } else {
                        left.*.status = qast::QAST_Status.Error
                        this.recover(ctx)
                        return left
                    }
                }
            }

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        return left
    }

    @this
    make parse_logic_or (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_logic_and(ctx)

        if this.current().*.kind == lexer::TokenKind.DoublePipe {
            make op: lexer::Token = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_logic_and(ctx)

            // make left_node: owned<qast::QAST_Expr>
            @unsafe {
                if left.*.kind != qast::QAST_Kind.Expr {
                //     @unsafe make expr: owned<qast::QAST_Expr> = left
                //     left_node = expr
                // } else {
                    make d = diag::Diag.panic(err::Err.BadNodeKind, "compiler encountered an unexpected node kind")
                    if ctx.*.diag.report(d) && ctx.*.lsp_mode == false { std::process::abort() } else {
                        left.*.status = qast::QAST_Status.Error
                        this.recover(ctx)
                        return left
                    }
                }
            }

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_logic_and (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_bitwise_or(ctx)

        if this.current().*.kind == lexer::TokenKind.DoubleAmpersand {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_bitwise_or(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_bitwise_or (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_bitwise_xor(ctx)

        if this.current().*.kind == lexer::TokenKind.Pipe {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_bitwise_or(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_bitwise_xor (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_bitwise_and(ctx)

        if this.current().*.kind == lexer::TokenKind.Caret {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_bitwise_or(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_bitwise_and (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_equality(ctx)

        if this.current().*.kind == lexer::TokenKind.Ampersand {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_equality(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_equality (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_comparison(ctx)

        if this.current().*.kind == lexer::TokenKind.EqualEqual || this.current().*.kind == lexer::TokenKind.NotEqual {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_comparison(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_comparison (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_shift(ctx)

        if this.current().*.kind == lexer::TokenKind.LessEqual || this.current().*.kind == lexer::TokenKind.GreaterEqual
            || this.current().*.kind == lexer::TokenKind.Less || this.current().*.kind == lexer::TokenKind.Greater {

            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_shift(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_shift (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_ternary(ctx)

        if this.current().*.kind == lexer::TokenKind.ShiftLeft || this.current().*.kind == lexer::TokenKind.ShiftRight {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_ternary(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        @unsafe return left
    }

    @this
    make parse_ternary (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_factor(ctx)

        if this.current().*.kind == lexer::TokenKind.Plus || this.current().*.kind == lexer::TokenKind.Minus {
            make op = this.current().*
            this.advance()

            make right: owned<qast::QAST_Head> = this.parse_factor(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        return left
    }

    @this
    make parse_factor (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_unary(ctx)

        if this.current().*.kind == lexer::TokenKind.Asterisk || this.current().*.kind == lexer::TokenKind.Slash {
            make op = this.current().*
            this.advance()
            make right: owned<qast::QAST_Head> = this.parse_unary(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Binary
            expr.*.binary.left = left
            expr.*.binary.op = op
            expr.*.binary.right = right

            @unsafe left = expr
        }

        return left
    }

    @this
    make parse_unary (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_postfix(ctx)

        if this.current().*.kind == lexer::TokenKind.Not || this.current().*.kind == lexer::TokenKind.Minus
            || this.current().*.kind == lexer::TokenKind.Tilde {

            make op = this.current().*
            this.advance()

            make right = this.parse_postfix(ctx)

            make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            expr.*.head.kind = qast::QAST_Kind.Expr
            expr.*.head.status = qast::QAST_Status.Ok

            expr.*.kind = qast::ExprKind.Unary
            expr.*.unary.op = op
            expr.*.unary.operand = left

            @unsafe left = expr
        }

        return left
    }

    @this
    make parse_postfix (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        make left: owned<qast::QAST_Head> = this.parse_primary(ctx)

        while true {

            if this.current().*.kind == lexer::TokenKind.LBracket {
                this.advance()

                make index = this.parse_expr(ctx)

                this.expect(lexer::TokenKind.RBracket) catch {
                    left.*.status = qast::QAST_Status.Error

                    make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
                    ctx.*.diag.report(d)

                    this.recover(ctx)
                    return left
                }

                make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
                expr.*.head.status = qast::QAST_Status.Ok
                expr.*.head.kind = qast::QAST_Kind.Expr
                expr.*.kind = qast::ExprKind.Access

                expr.*.access.left = left
                expr.*.access.right = index
                expr.*.access.is_array = true

                @unsafe left = expr
            } elif this.current().*.kind == lexer::TokenKind.LParen {
                this.advance()

                make args: qast::QAST_Arg[] = this.parse_args(ctx)

                this.expect(lexer::TokenKind.RParen) catch {
                    left.*.status = qast::QAST_Status.Error

                    make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
                    ctx.*.diag.report(d)

                    this.recover(ctx)
                    return left
                }

                make bind: variant<void, lexer::Token>
                make catch_stmts: qast::QAST_Statements?

                if this.current().*.kind == lexer::TokenKind.KeyCatch {
                    this.advance()

                    if this.current().*.kind == lexer::TokenKind.Identifier {
                        bind = this.current().*
                        this.advance()
                    }

                    catch_stmts = this.parse_statements(ctx)
                }

                make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
                expr.*.head.status = qast::QAST_Status.Ok
                expr.*.head.kind = qast::QAST_Kind.Expr
                expr.*.kind = qast::ExprKind.Call

                expr.*.call.callee = left
                expr.*.call.args = args
                expr.*.call.catch_bind = bind
                expr.*.call.catch_stmts = catch_stmts
                @unsafe left = expr
            } else {
                break
            }
        }

        return left
    }

    @this
    make parse_primary (ctx: ptr<um::Unit>) -> owned<qast::QAST_Head> {
        if this.current().*.kind == lexer::TokenKind.LiteralNum || this.current().*.kind == lexer::TokenKind.LiteralString
        || this.current().*.kind == lexer::TokenKind.LiteralChar || this.current().*.kind == lexer::TokenKind.KeyTrue
        || this.current().*.kind == lexer::TokenKind.KeyFalse || this.current().*.kind == lexer::TokenKind.KeyNone {

            make e: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            e.*.head.status = qast::QAST_Status.Ok
            e.*.head.kind = qast::QAST_Kind.Expr

            e.*.kind = qast::ExprKind.Literal
            e.*.literal = this.current().*

            this.advance()

            @unsafe return e
        }

        if this.current().*.kind == lexer::TokenKind.Identifier || this.current().*.kind == lexer::TokenKind.KeyError {

            if this.is_type_constructor(ctx) {
                make e: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
                e.*.head.status = qast::QAST_Status.Ok
                e.*.head.kind = qast::QAST_Kind.Expr

                e.*.kind = qast::ExprKind.Constructor

                e.*.constructor.fields = []

                this.expect(lexer::TokenKind.LBrace) catch {
                }

                while this.current().*.kind != lexer::TokenKind.RBrace {

                    e.*.constructor.fields.push(this.parse_expr(ctx))

                    if this.current().*.kind == lexer::TokenKind.Comma {
                        this.advance()
                    } elif this.current().*.kind == lexer::TokenKind.RBrace {
                        break
                    } else {
                        e.*.head.status = qast::QAST_Status.Error

                        make d = diag::Diag.err(err::Err.UnexpectedToken, util::Range {}, "unexpected token")
                        ctx.*.diag.report(d)

                        this.recover(ctx)
                        @unsafe return e
                    }
                }

                @unsafe return e
            }
        }

        // handle identifier as fallback (not a constructor)
        if this.current().*.kind == lexer::TokenKind.Identifier || this.current().*.kind == lexer::TokenKind.KeyError {
            make e: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
            e.*.head.status = qast::QAST_Status.Ok
            e.*.head.kind = qast::QAST_Kind.Expr
            e.*.kind = qast::ExprKind.Identifier
            e.*.literal = this.current().*
            this.advance()
            @unsafe return e
        }

        make expr: owned<qast::QAST_Expr> = std::mem::debug.alloc(@sizeof qast::QAST_Expr).unwrap()
        expr.*.head.kind = qast::QAST_Kind.Expr
        expr.*.head.status = qast::QAST_Status.Error

        this.recover(ctx)

        @unsafe return expr
    }

    @this
    make recover (ctx: ptr<um::Unit>) {
        make depth = 0

        while this.current().*.kind != lexer::TokenKind.EOF {
            make t = this.current().*.kind

            if depth == 0 {
                match t {

                    // lexer::TokenKind.KeyType { return }
                    lexer::TokenKind.KeyMake { return }
                    // lexer::TokenKind.KeyEnum { return }
                    lexer::TokenKind.KeyIf { return }
                    lexer::TokenKind.KeyFor { return }
                    lexer::TokenKind.KeyWhile { return }
                    lexer::TokenKind.KeyMatch { return }
                    lexer::TokenKind.KeyCatch { return }
                    lexer::TokenKind.KeyReturn { return }

                    _ { break }

                }
            }

            match t {

                lexer::TokenKind.LParen {
                    depth = depth + 1
                    break
                }

                lexer::TokenKind.LBrace {
                    depth = depth + 1
                    break
                }

                lexer::TokenKind.LBracket {
                    depth = depth + 1
                    break
                }

                lexer::TokenKind.RParen { if depth > 0 { depth = depth - 1 } break }
                lexer::TokenKind.RBrace { if depth > 0 { depth = depth - 1 } break }
                lexer::TokenKind.RBracket { if depth > 0 { depth = depth - 1 } break }

                _ { break }
            }


            this.advance()
        }

        make d = diag::Diag.panic(err::Err.UnexpectedEndOfFile, "unexpected end of file while recovering")
        if ctx.*.diag.report(d) {
            std::process::abort()
        }
    }

    @this
    make is_type_constructor (ctx: ptr<um::Unit>) -> bool {

        // Type {}
        // Type <T, U> {}

        // type constructor starts with identfier
        if this.current().*.kind != lexer::TokenKind.Identifier { return false }
        return false
    }
}

// DEBUG

@pub
make debug_display (p: owned<qast::QAST_Head>[]) -> void {
    std::io::println("=== AST Tree ===")
    for node : p.iter() {
        _print_node(node, 0)
    }
}



make _print_node (node: owned<qast::QAST_Head>, depth: int) -> void {
    @unsafe {
        match node.*.kind {
            qast::QAST_Kind.Tag {
                make tag: owned<qast::QAST_Tag> = node
                _print_indent(depth)
                std::io::print("@")
                _print_indent(depth)
                std::io::println(tag.*.name.lexeme)
                make tag_val = tag.*.val

                match tag.*.val {
                    none {}

                    _ {
                        _print_indent(depth)
                        std::io::println("val:")
                        _print_node(tag.*.val.unwrap(), depth + 1)
                    }
                }
            }

            qast::QAST_Kind.Func {
                make func: owned<qast::QAST_Func> = node
                _print_indent(depth)
                std::io::println("Func:")
                _print_indent(depth)
                std::io::println(func.*.name.lexeme)
                _print_indent(depth)
                std::io::println("params:")
                make pi = 0
                while pi < func.*.params.len() {
                    make param = func.*.params[pi]
                    _print_indent(depth + 1)
                    std::io::println(param.name.lexeme)
                    pi = pi + 1
                }
                _print_indent(depth)
                std::io::println("body:")
                make si = 0
                while si < func.*.statements.buffer.len() {
                    _print_node(func.*.statements.buffer[si], depth + 1)
                    si = si + 1
                }
            }

            qast::QAST_Kind.Var {
                make var: owned<qast::QAST_Var> = node
                _print_indent(depth)
                std::io::println("Var:")
                _print_indent(depth + 1)
                std::io::println(var.*.name.lexeme)
                _print_indent(depth)
                std::io::println("sig:")
                _print_indent(depth + 1)

                if var.*.sig_type != none {
                    std::io::println(var.*.sig_type.unwrap().*.name.lexeme)
                }

                if var.*.val != none {
                    _print_indent(depth)
                    std::io::println("val:")
                    _print_node(var.*.val.unwrap(), depth + 1)
                }


                // match var_val {
                //     val: owned<qast::QAST_Head> {
                //         _print_indent(depth)
                //         std::io::println("val:")
                //         _print_node(val, depth + 1)
                //     }
                //     _ { }
                // }
            }

            qast::QAST_Kind.Expr {
                make expr: owned<qast::QAST_Expr> = node
                _print_expr(expr, depth)
            }
        }
    }
}

make _print_expr (expr: owned<qast::QAST_Expr>, depth: int) -> void {
    match expr.*.kind {
        qast::ExprKind.Unknown {
            _print_indent(depth)
            std::io::println("Expr: <?>")
        }

        qast::ExprKind.Literal {
            _print_indent(depth)
            std::io::println("Literal:")
            _print_indent(depth + 1)
            std::io::println(expr.*.literal.lexeme)
        }

        qast::ExprKind.Identifier {
            _print_indent(depth)
            std::io::println("Identifier:")
            _print_indent(depth + 1)
            std::io::println(expr.*.literal.lexeme)
        }

        qast::ExprKind.Binary {
            _print_indent(depth)
            std::io::println("Binary:")
            _print_indent(depth + 1)
            std::io::println(expr.*.binary.op.lexeme)
            _print_indent(depth)
            std::io::println("left:")
            _print_node(expr.*.binary.left, depth + 1)
            _print_indent(depth)
            std::io::println("right:")
            _print_node(expr.*.binary.right, depth + 1)
        }

        qast::ExprKind.Unary {
            _print_indent(depth)
            std::io::println("Unary:")
            _print_indent(depth + 1)
            std::io::println(expr.*.unary.op.lexeme)
            _print_indent(depth)
            std::io::println("operand:")
            _print_node(expr.*.unary.operand, depth + 1)
        }

        qast::ExprKind.Call {
            _print_indent(depth)
            std::io::println("Call:")
            _print_indent(depth)
            std::io::println("callee:")
            _print_node(expr.*.call.callee, depth + 1)
            _print_indent(depth)
            std::io::println("args:")
            make ai = 0
            while ai < expr.*.call.args.len() {
                make arg = expr.*.call.args[ai]
                _print_indent(depth + 1)
                std::io::println(arg.name.lexeme)
                _print_node(arg.val, depth + 2)
                ai = ai + 1
            }
        }

        qast::ExprKind.Access {
            _print_indent(depth)
            std::io::println("Access:")
            _print_indent(depth)
            std::io::println("left:")
            _print_node(expr.*.access.left, depth + 1)
            _print_indent(depth)
            std::io::println("right:")
            _print_node(expr.*.access.right, depth + 1)
        }

        qast::ExprKind.Constructor {
            _print_indent(depth)
            std::io::println("Constructor:")
            make fi = 0
            while fi < expr.*.constructor.fields.len() {
                _print_node(expr.*.constructor.fields[fi], depth + 1)
                fi = fi + 1
            }
        }
    }
}

make _print_indent (depth: int) -> void {
    make i = 0
    while i < depth {
        std::io::print("  ")
        i = i + 1
    }
}
